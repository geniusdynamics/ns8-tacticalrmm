#
# One-shot setup of Tactical RMM: copies the code to the tactical_data
# volume, runs the migrations, creates the dashboard user and writes the
# ready file the other containers wait for. It runs in the foreground and
# stays "active (exited)" after a successful run.
#

[Unit]
Description=Podman tactical-init.service
BindsTo=tacticalrmm.service
After=tacticalrmm.service postgresql-app.service redis-app.service tactical-meshcentral.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
Type=exec
RemainAfterExit=yes
Restart=on-failure
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/tactical-init.ctr-id
ExecStart=/usr/bin/podman run --rm \
    --cidfile %t/tactical-init.ctr-id \
    --pod-id-file %t/tacticalrmm.pod-id --replace --name tactical-init \
    --volume tactical_data:/opt/tactical:z \
    --volume mesh_data:/meshcentral-data:z \
    --env-file=%E/state/tactical.env \
    --env POSTGRES_HOST=127.0.0.1 \
    --env POSTGRES_USER=postgres \
    --env POSTGRES_DB=tacticalrmm \
    --env REDIS_HOST=127.0.0.1 \
    --env MESH_SERVICE=127.0.0.1 \
    --env NATS_CONNECT_HOST=127.0.0.1 \
    --env APP_HOST=${TRAEFIK_HOST} \
    --env API_HOST=${API_HOST} \
    --env MESH_HOST=${MESH_HOST} \
    --env MESH_USER=${MESH_USER} \
    --env TRMM_USER=${TACTICAL_USER} \
    ${TACTICAL_IMAGE} tactical-init
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/tactical-init.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/tactical-init.ctr-id
SyslogIdentifier=%u

[Install]
WantedBy=default.target
