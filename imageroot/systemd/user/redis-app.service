[Unit]
Description=Podman redis-app.service
BindsTo=tacticalrmm.service
After=tacticalrmm.service
Before=tactical-init.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
Restart=always
RestartSec=10
TimeoutStopSec=70
TimeoutStartSec=300
# Report started only when Redis answers
ExecStartPost=/usr/bin/bash -c "for i in $$(seq 1 60); do /usr/bin/podman exec redis-app redis-cli ping | grep -q PONG && exit 0; sleep 2; done; exit 1"
ExecStartPre=/bin/rm -f %t/redis-app.pid %t/redis-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/redis-app.pid \
    --cidfile %t/redis-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/tacticalrmm.pod-id --replace -d --name redis-app \
    --volume redis-data:/data:Z \
    ${REDIS_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/redis-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/redis-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/redis-app.pid
Type=forking

[Install]
WantedBy=default.target
