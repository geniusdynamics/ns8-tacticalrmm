#
# Pod of the Tactical RMM instance. All the containers share 127.0.0.1.
# Traefik sends the app, API and MeshCentral host names to the nginx
# container, on port 8000 of the pod.
#

[Unit]
Description=Podman tacticalrmm.service
Requires=postgresql-app.service redis-app.service tactical-nginx.service tactical-meshcentral.service tactical-backend.service tactical-websockets.service tactical-celery.service tactical-celerybeat.service tactical-nats.service tactical-frontend.service
Wants=tactical-init.service
Before=postgresql-app.service redis-app.service tactical-nginx.service tactical-meshcentral.service tactical-init.service tactical-backend.service tactical-websockets.service tactical-celery.service tactical-celerybeat.service tactical-nats.service tactical-frontend.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/tacticalrmm.pid %t/tacticalrmm.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/tacticalrmm.pid \
    --pod-id-file %t/tacticalrmm.pod-id \
    --name tacticalrmm \
    --publish 127.0.0.1:${TCP_PORT}:8000 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/tacticalrmm.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/tacticalrmm.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/tacticalrmm.pod-id
PIDFile=%t/tacticalrmm.pid
Type=forking

[Install]
WantedBy=default.target
