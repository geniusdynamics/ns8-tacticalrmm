# Remove the traefik routes of the web UI, of the API and of MeshCentral

import os
import sys
import agent
import agent.tasks

default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is None:
    sys.exit(0)

for instance in ('', '-api', '-mesh'):
    agent.tasks.run(
        agent_id=default_traefik_id,
        action='delete-route',
        data={'instance': os.environ['MODULE_ID'] + instance},
    )
