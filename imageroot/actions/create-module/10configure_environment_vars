# Generate the secrets of the instance. They are kept in state files with
# mode 0600 and passed to the containers with --env-file.

import os
import secrets


def write_secret_file(name, values):
    path = os.path.join(os.environ.get("AGENT_STATE_DIR", "."), name)
    if os.path.exists(path):
        return  # never overwrite existing secrets (clone, restore)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        for key, value in values.items():
            f.write(f"{key}={value}\n")


postgres_password = secrets.token_hex(16)

# PostgreSQL container
write_secret_file("database.env", {
    "POSTGRES_DB": "tacticalrmm",
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": postgres_password,
})

# Tactical RMM init container: database access and first dashboard user
write_secret_file("tactical.env", {
    "POSTGRES_PASS": postgres_password,
    "TRMM_PASS": secrets.token_urlsafe(16),
})

# MeshCentral container: password of the MeshCentral admin account
write_secret_file("meshcentral.env", {
    "MESH_PASS": secrets.token_urlsafe(16),
})
