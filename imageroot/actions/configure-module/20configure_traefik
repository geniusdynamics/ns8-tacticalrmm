import json
import os
import sys

import agent

data = json.load(sys.stdin)

host = data["host"]
h2hs = data.get("http2https", True)
le = data.get("lets_encrypt", False)

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
agent.set_env("TRAEFIK_LETS_ENCRYPT", le)

# The web UI, the API and MeshCentral have their own host names. The nginx
# container of the pod dispatches them by host name, on the same port.
routes = {
    os.environ["MODULE_ID"]: host,
    os.environ["MODULE_ID"] + "-api": os.environ["API_HOST"],
    os.environ["MODULE_ID"] + "-mesh": os.environ["MESH_HOST"],
}
for instance, route_host in routes.items():
    agent.set_route({
        "instance": instance,
        "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
        "host": route_host,
        "http2https": h2hs,
        "lets_encrypt": le,
    })
