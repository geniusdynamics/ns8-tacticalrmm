# Store the host names and accounts, update the secrets given by the
# admin, and render the configuration files of the nginx reverse proxy
# and of MeshCentral.

import json
import os
import sys

import agent

data = json.load(sys.stdin)

host = data["host"]
api_host = data.get("API_HOST") or os.environ.get("API_HOST") or f"api.{host}"
mesh_host = data.get("MESH_HOST") or os.environ.get("MESH_HOST") or f"mesh.{host}"
mesh_user = (data.get("MESH_USER") or os.environ.get("MESH_USER") or "meshadmin").lower()
tactical_user = data.get("TACTICAL_USER") or os.environ.get("TACTICAL_USER") or "admin"

agent.set_env("API_HOST", api_host)
agent.set_env("MESH_HOST", mesh_host)
agent.set_env("MESH_USER", mesh_user)
agent.set_env("TACTICAL_USER", tactical_user)


def update_secret(name, key, value):
    """Set key=value in a 0600 state file, keeping the other lines"""
    if not value:
        return
    values = agent.read_envfile(name) if os.path.exists(name) else {}
    values[key] = value
    tmp = f"{name}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for k, v in values.items():
            f.write(f"{k}={v}\n")
    os.replace(tmp, name)


# The dashboard user is created by tactical-init only if it does not exist
update_secret("tactical.env", "TRMM_PASS", data.get("TACTICAL_PASSWORD"))
update_secret("meshcentral.env", "MESH_PASS", data.get("MESH_PASSWORD"))

# Reverse proxy in front of the frontend, the API and MeshCentral. Traefik
# terminates TLS and sends every host name to this nginx, on port 8000 of
# the pod. All the containers of the pod share 127.0.0.1:
#   frontend 8081, uwsgi 8080, websockets 8383, nats-ws 9235, mesh 4443
proxy_headers = """
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;"""

nginx_conf = f"""# Generated by configure-module, do not edit
server {{
    listen 8000 default_server;
    server_name {host};

    location / {{
        proxy_pass http://127.0.0.1:8081;{proxy_headers}
    }}
}}

server {{
    listen 8000;
    server_name {api_host};
    client_max_body_size 300M;

    location / {{
        include uwsgi_params;
        uwsgi_param HTTPS on;
        uwsgi_param UWSGI_SCHEME https;
        uwsgi_pass 127.0.0.1:8080;
    }}

    location /static/ {{
        root /opt/tactical/api/;
        add_header "Access-Control-Allow-Origin" "https://{host}";
    }}

    location /private/ {{
        internal;
        add_header "Access-Control-Allow-Origin" "https://{host}";
        alias /opt/tactical/api/tacticalrmm/private/;
    }}

    location /assets/ {{
        internal;
        add_header "Access-Control-Allow-Origin" "https://{host}";
        alias /opt/tactical/reporting/assets/;
    }}

    location ~ ^/ws/ {{
        proxy_pass http://127.0.0.1:8383;
        proxy_redirect off;{proxy_headers}
    }}

    location ~ ^/natsws {{
        proxy_pass http://127.0.0.1:9235;{proxy_headers}
    }}
}}

server {{
    listen 8000;
    server_name {mesh_host};
    proxy_send_timeout 330s;
    proxy_read_timeout 330s;

    location / {{
        proxy_pass http://127.0.0.1:4443;{proxy_headers}
    }}
}}
"""
with open("nginx.conf.tmp", "w") as f:
    f.write(nginx_conf)
os.replace("nginx.conf.tmp", "nginx.conf")

# MeshCentral configuration. It keeps its data in the built-in NeDB
# database of the mesh_data volume, so no MongoDB container is needed.
# HTTP only on 4443 (TLS is terminated by Traefik), and no redirection
# server, because port 8080 belongs to uwsgi.
mesh_config = {
    "settings": {
        "cert": mesh_host,
        "tlsOffload": "127.0.0.1",
        "WANonly": True,
        "port": 4443,
        "redirPort": 0,
        "aliasPort": 443,
        "agentAliasPort": 443,
        "allowLoginToken": True,
        "allowFraming": True,
        "agentPing": 35,
        "allowHighQualityDesktop": True,
        "agentCoreDump": False,
        "compression": False,
        "wsCompression": False,
        "agentWsCompression": False,
        "webRTC": False,
        "autoBackup": False,
        "maxInvalidLogin": {"time": 5, "count": 5, "coolofftime": 30},
    },
    "domains": {
        "": {
            "title": "Tactical RMM",
            "title2": "TacticalRMM",
            "newAccounts": False,
            "mstsc": True,
            "geoLocation": True,
            "certUrl": f"https://{mesh_host}:443/",
            "agentConfig": ["webSocketMaskOverride=0"],
        }
    },
}
with open("meshcentral-config.json.tmp", "w") as f:
    json.dump(mesh_config, f, indent=2)
os.replace("meshcentral-config.json.tmp", "meshcentral-config.json")
