#
# Read configuration. Every reader can run this action: never return the
# passwords, which stay in the 0600 state files.
#

import os
import sys
import json

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
    "API_HOST": os.getenv("API_HOST", ""),
    "MESH_HOST": os.getenv("MESH_HOST", ""),
    "MESH_USER": os.getenv("MESH_USER", ""),
    "TACTICAL_USER": os.getenv("TACTICAL_USER", ""),
}

json.dump(config, fp=sys.stdout)
